name: "lowrisc:prim:ram_1p_adv:0.1"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim:util
      - lowrisc:prim:secded
      - lowrisc:prim:ram_1p
    files:
      - rtl/prim_ram_1p_adv.sv
    file_type: systemVerilogSource

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
    files:
      - lint/prim_ram_1p_adv.waiver
    file_type: waiver

targets:
  default:
    filesets:
      - files_rtl
