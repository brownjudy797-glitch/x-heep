name: "lowrisc:prim:otp_pkg:0.1"
description: "Package with common interface definitions for OTP primitives."
filesets:
  files_rtl:
    files:
      - rtl/prim_otp_pkg.sv
    file_type: systemVerilogSource

targets:
  default: &default_target
    filesets:
      - files_rtl

  lint:
    <<: *default_target
    default_tool: verilator
    parameters:
      - SYNTHESIS=true
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
