name: "lowrisc:prim:prim_dom_and_2share:0.1"
description: "Domain-Oriented Masking AND"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
    files:
      - rtl/prim_dom_and_2share.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
    files:
      - lint/prim.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
    files:
      - lint/prim.waiver
    file_type: waiver

targets:
  default: &default_target
    filesets:
      - files_rtl
    toplevel: prim_dom_and_2share
  formal:
    filesets:
      - files_rtl
    toplevel: prim_dom_and_2share

