`verilator_config

// lint_off -rule PROCASSINIT -file "*tb/yosys_spiflash.sv" -match "Procedural assignment to declaration with initial value: '*'"
lint_off -rule UNOPTFLAT -file "*xbar_varlat_one_to_n.sv" -match "*"

// Simulation models and testbench files use constructs not suitable for synthesis
lint_off -rule BLKSEQ -file "*" -match "*"
lint_off -rule WIDTHEXPAND -file "*" -match "*"
lint_off -rule WIDTHTRUNC -file "*" -match "*"
lint_off -rule UNDRIVEN -file "*" -match "*"
lint_off -rule DECLFILENAME -file "*" -match "*"
lint_off -rule SYNCASYNCNET -file "*" -match "*"
